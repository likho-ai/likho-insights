# Committed: no secrets here. Secrets for this environment live in .env.staging.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.staging, .env.staging.local; a real environment variable wins.

LIKHO_ENV=staging
LOG_LEVEL=INFO
GRPC_PORT=5050
HTTP_PORT=4050

# The cluster (likho-deploy)
MONGO_URL=mongodb://mongo:27017
MONGO_DATABASE=likho_insights
NATS_URL=nats://nats:4222
TRANSCRIPTION_GRPC_ADDR=likho-transcription:5020

# The model. ANTHROPIC_API_KEY goes in .env.staging.local; while it is empty, nothing is
# analysed and no transcript text leaves this machine.
ANTHROPIC_MODEL=claude-sonnet-5-5
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_OUTPUT_TOKENS=2000
MAX_TRANSCRIPT_CHARS=24000
REPORT_LANGUAGE=English

# The auditor's form. The company's own goes in config/qa.local.json (ignored by git).
QA_FORM_FILE=config/qa.example.json

CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-insights
CONSUMER_START=new

# How long the start keeps trying to reach NATS before going on without it.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
